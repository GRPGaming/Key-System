    )
    toClick:Play()
    toClick.Completed:Connect(function()
        toOriginal:Play()
    end)
end

-- Fungsi universal untuk copy link
local function universalCopyLink(cacheFunction, messagePrefix)
    messagePrefix = messagePrefix or ""
    
    local success, link = cacheFunction()
    if not success then
        onMessage(messagePrefix .. "Failed to generate link!")
        return false
    end
    
    local clipboardFunc = getClipboardFunction()
    
    if clipboardFunc then
        local copySuccess = pcall(function()
            clipboardFunc(link)
        end)
        
        if copySuccess then
            onMessage(messagePrefix .. "Link copied to clipboard!")
            return true
        else
            onMessage(messagePrefix .. "Copy failed. Visit: " .. link)
            return false
        end
    else
        onMessage(messagePrefix .. "Clipboard not supported. Visit: " .. link)
        pcall(function()
            game:GetService("StarterGui"):SetCore("ChatMakeSystemMessage", {
                Text = "Link: " .. link,
                Color = Color3.fromRGB(255, 255, 0)
            })
        end)
        
        return false
    end
end

