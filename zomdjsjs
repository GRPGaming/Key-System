local function isGiftKey(key)
    return fStringSub(key, 1, 4) == "KEY_"
end

local function redeemGiftKey(key)
    if not fRequest then
        onMessage("Error: Cannot redeem gift key, HTTP requests not supported.")
        return false
    end
    local nonce = generateNonce()
    local endpoint = host .. "/public/redeem/" .. fToString(service)
    local body = {
        identifier = lDigest(fGetHwid()),
        key = key,
        isGift = true
    }
    if useNonce then 
        body.nonce = nonce 
    end
    local success, response = pcall(function()
        return fRequest({
            Url = endpoint,
            Method = "POST",
            Body = lEncode(body),
            Headers = {
                ["Content-Type"] = "application/json"
            }
        })
    end)
    if success and response.StatusCode == 200 then
        local decoded = lDecode(response.Body)
        if decoded.success then
            if decoded.data.valid then
                if useNonce and decoded.data.hash ~= lDigest("true" .. "-" .. nonce .. "-" .. secret) then
                    onMessage("Gift integrity check failed.")
                    return false
                end    
                saveKey(key)
                return true
            else
                onMessage("Gift key already used or invalid.")
                return false
            end
        else
            onMessage(decoded.message)
            return false
        end
    end
    return false
end

