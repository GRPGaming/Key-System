        -- Fungsi untuk animasi button click
local function animateButtonClick(button, originalColor, clickColor, duration)
    duration = duration or 3 -- default 1 detik
    
    -- Ubah ke warna click
    button.BackgroundColor3 = clickColor
    
    -- Kembalikan ke warna asli setelah durasi
    spawn(function()
        wait(duration)
        button.BackgroundColor3 = originalColor
    end)
end

-- Alternatif dengan TweenService untuk animasi yang lebih smooth
local TweenService = game:GetService("TweenService")

local function smoothAnimateButtonClick(button, originalColor, clickColor, duration)
    duration = duration or 3
    
    -- Tween ke warna click (cepat)
    local tweenToClick = TweenService:Create(
        button,
