-- Fungsi untuk toggle Freeze
local function toggleFreeze()
    isFrozen = not isFrozen
    
    if isFrozen then
        humanoid.WalkSpeed = 0
        humanoid.JumpPower = 0

        bodyVelocity = Instance.new("BodyVelocity")
        bodyVelocity.Velocity = Vector3.new(0, 0, 0)
        bodyVelocity.MaxForce = Vector3.new(4000, 4000, 4000)
        bodyVelocity.Parent = humanoidRootPart

        noCollide = Instance.new("BoolValue")
        noCollide.Name = "NoCollide"
        noCollide.Parent = character
        for _, part in pairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    else
        humanoid.WalkSpeed = 16
        humanoid.JumpPower = 50
        if bodyVelocity then bodyVelocity:Destroy() end
        if noCollide then noCollide:Destroy() end
        for _, part in pairs(character:GetChildren()) do
            if part:IsA("BasePart") then
                part.CanCollide = true
            end
        end
    end
end

-- Fungsi untuk melakukan teleportasi mining
local function mineOre()
    while isMining do
        for _, location in ipairs(oreLocations) do
            if not isMining then return end
            humanoidRootPart.CFrame = CFrame.new(location)
            task.wait(8) -- Delay 8 detik sebelum pindah ke lokasi berikutnya
        end
    end
end

-- Fungsi untuk toggle Mining
local function toggleMining()
    isMining = not isMining

    if isMining then
        miningButton.Text = "Manually Mining [ √ ]"
        task.spawn(mineOre)
    else
        miningButton.Text = "Manually Mining [ × ]"
    end
end

