					AddThemeObject(SetProps(MakeElement("Label",KeybindConfig.Name,14),{Size=UDim2.new(1,-10,1,0),Position=UDim2.new(0,10,0,0),Font=Enum.Font.GothamBold,Name="Content"}),"Text"),
					AddThemeObject(SetProps(MakeElement("Label",KeyText,14),{Size=UDim2.new(0,60,1,0),Position=UDim2.new(1,-70,0,0),Font=Enum.Font.GothamSemibold,Name="Value",TextXAlignment=Enum.TextXAlignment.Right}),"Text"),
