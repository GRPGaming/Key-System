					end
					for _,Option in pairs(Dropdown.Options) do
						local OptionBtn=AddThemeObject(SetChildren(SetProps(MakeElement("Button"),{Size=UDim2.new(1,0,0,20),BackgroundColor3=OrionLib.Themes[OrionLib.SelectedTheme].Second}),{
							AddThemeObject(SetProps(MakeElement("Label",Option,14),{Size=UDim2.new(1,-10,1,0),Position=UDim2.new(0,5,0,0),Font=Enum.Font.GothamSemibold,TextXAlignment=Enum.TextXAlignment.Left}),"Text")
						}),"Second")
						OptionBtn.Parent=DropList

						AddConnection(OptionBtn.MouseButton1Click,function()
							Dropdown:Set(Option)
							SaveCfg(game.GameId)
							IsDropped=false
							DropList.Visible=false
							DropdownFrame.DropBtn.ImageLabel.Image="rbxassetid://7072706620"
							DropList.Size=UDim2.new(1,0,0,0)
						end)
					end
					DropList.CanvasSize=UDim2.new(0,0,0,DropList.UIListLayout.AbsoluteContentSize.Y+4)
					if IsDropped then
						DropList.Size=UDim2.new(1,0,0,math.min(DropList.UIListLayout.AbsoluteContentSize.Y+4,80))
					end
				end

				function Dropdown:Set(Value)
					Dropdown.Value=Value
					DropdownFrame.Value.Text=Value
					DropdownConfig.Callback(Value)
				end

				function Dropdown:Refresh(NewOptions)
					Dropdown.Options=NewOptions
					Dropdown.Value=Dropdown.Options[1] or "..."
					DropdownFrame.Value.Text=Dropdown.Value
					UpdateDropList()
				end

				AddConnection(DropdownFrame.DropBtn.MouseButton1Click,function()
					IsDropped=not IsDropped
					DropList.Visible=IsDropped
					DropdownFrame.DropBtn.ImageLabel.Image=IsDropped and "rbxassetid://7072706743" or "rbxassetid://7072706620"
					DropList.Size=IsDropped and UDim2.new(1,0,0,math.min(DropList.UIListLayout.AbsoluteContentSize.Y+4,80)) or UDim2.new(1,0,0,0)
				end)

				Dropdown:Refresh(DropdownConfig.Options)
				Dropdown:Set(Dropdown.Value)

				if DropdownConfig.Flag then OrionLib.Flags[DropdownConfig.Flag]=Dropdown end
				return Dropdown
			end

