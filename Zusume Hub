				ColorpickerConfig.Name=ColorpickerConfig.Name or "Colorpicker"
				ColorpickerConfig.Default=ColorpickerConfig.Default or Color3.fromRGB(255,255,255)
				ColorpickerConfig.Callback=ColorpickerConfig.Callback or function() end
				ColorpickerConfig.Flag=ColorpickerConfig.Flag or nil
				ColorpickerConfig.Save=ColorpickerConfig.Save or false

				local Colorpicker={Value=ColorpickerConfig.Default,Default=ColorpickerConfig.Default,Type="Colorpicker",Save=ColorpickerConfig.Save}
				local H,S,V=ColorpickerConfig.Default:ToHSV()
				local IsPickingHue=false
				local IsPickingSV=false

				local ColorpickerFrame=AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame",Color3.fromRGB(255,255,255),0,5),{Size=UDim2.new(1,0,0,25),Parent=ItemParent}),{
					AddThemeObject(SetProps(MakeElement("Label",ColorpickerConfig.Name,14),{Size=UDim2.new(1,-10,1,0),Position=UDim2.new(0,10,0,0),Font=Enum.Font.GothamBold,Name="Content"}),"Text"),
					SetProps(MakeElement("Frame"),{Size=UDim2.new(0,20,0,20),Position=UDim2.new(1,-25,0.5,0),AnchorPoint=Vector2.new(1,0.5),Name="ColorPreview"}),
					AddThemeObject(MakeElement("Stroke"),"Stroke"),
					SetProps(MakeElement("Button"),{Size=UDim2.new(1,0,1,0),Name="PickBtn"})
				}),"Second")

				local ColorPreview=ColorpickerFrame.ColorPreview
				ColorPreview.BackgroundColor3=ColorpickerConfig.Default
				MakeElement("Corner",0,4).Parent=ColorPreview

				local PickerFrame=AddThemeObject(SetProps(MakeElement("RoundFrame",Color3.fromRGB(25,25,25),0,5),{Size=UDim2.new(0,150,0,0),Position=UDim2.new(1,5,0,0),Visible=false,Name="Picker"}),"Main")
				PickerFrame.Parent=ColorpickerFrame
				MakeElement("Stroke",Color3.fromRGB(93,93,93),1.2).Parent=PickerFrame

				local SVPicker=SetProps(MakeElement("Frame"),{Size=UDim2.new(0,100,0,100),Position=UDim2.new(0,5,0,5)})
				SVPicker.Parent=PickerFrame
				MakeElement("Corner",0,4).Parent=SVPicker
				local SVImage=SetProps(MakeElement("Image","rbxassetid://4155801252"),{Size=UDim2.new(1,0,1,0)})
				SVImage.Parent=SVPicker
				local SVGrab=SetProps(MakeElement("Frame"),{Size=UDim2.new(0,6,0,6),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.fromRGB(255,255,255)})
				SVGrab.Parent=SVPicker
				MakeElement("Corner",1).Parent=SVGrab
				MakeElement("Stroke",Color3.fromRGB(0,0,0),1.5).Parent=SVGrab

				local HuePicker=SetProps(MakeElement("Frame"),{Size=UDim2.new(0,20,0,100),Position=UDim2.new(1,-25,0,5)})
				HuePicker.Parent=PickerFrame
				MakeElement("Corner",0,4).Parent=HuePicker
				local HueImage=SetProps(MakeElement("Image","rbxassetid://4155801252"),{Size=UDim2.new(1,0,1,0),Image="rbxassetid://3641079629"})
				HueImage.Parent=HuePicker
				local HueGrab=SetProps(MakeElement("Frame"),{Size=UDim2.new(1,4,0,4),AnchorPoint=Vector2.new(0.5,0.5),BackgroundColor3=Color3.fromRGB(255,255,255)})
				HueGrab.Parent=HuePicker
				MakeElement("Corner",1).Parent=HueGrab
				MakeElement("Stroke",Color3.fromRGB(0,0,0),1.5).Parent=HueGrab

				local function UpdateColor()
					ColorPreview.BackgroundColor3=Colorpicker.Value
					SVImage.ImageColor3=Color3.fromHSV(H,1,1)
					SVGrab.Position=UDim2.new(S,0,1-V,0)
					HueGrab.Position=UDim2.new(0.5,0,H,0)
					ColorpickerConfig.Callback(Colorpicker.Value)
				end

				function Colorpicker:Set(Value)
					Colorpicker.Value=Value
					H,S,V=Value:ToHSV()
					UpdateColor()
				end

				AddConnection(ColorpickerFrame.PickBtn.MouseButton1Click,function()
					PickerFrame.Visible=not PickerFrame.Visible
					PickerFrame.Size=PickerFrame.Visible and UDim2.new(0,150,0,110) or UDim2.new(0,150,0,0)
				end)

				AddConnection(SVPicker.InputBegan,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseButton1 then
						IsPickingSV=true
					end
				end)

				AddConnection(SVPicker.InputEnded,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseButton1 then
						IsPickingSV=false
					end
				end)

				AddConnection(HuePicker.InputBegan,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseButton1 then
						IsPickingHue=true
					end
				end)

				AddConnection(HuePicker.InputEnded,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseButton1 then
						IsPickingHue=false
					end
				end)

				AddConnection(UserInputService.InputChanged,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseMovement then
						if IsPickingSV then
							local MousePos=UserInputService:GetMouseLocation()
							local RelativePos=MousePos-SVPicker.AbsolutePosition
							S=math.clamp(RelativePos.X/SVPicker.AbsoluteSize.X,0,1)
							V=1-math.clamp(RelativePos.Y/SVPicker.AbsoluteSize.Y,0,1)
							Colorpicker.Value=Color3.fromHSV(H,S,V)
							UpdateColor()
							SaveCfg(game.GameId)
						elseif IsPickingHue then
							local MousePos=UserInputService:GetMouseLocation()
							local RelativePos=MousePos-HuePicker.AbsolutePosition
							H=math.clamp(RelativePos.Y/HuePicker.AbsoluteSize.Y,0,1)
							Colorpicker.Value=Color3.fromHSV(H,S,V)
							UpdateColor()
							SaveCfg(game.GameId)
						end
					end
				end)

				Colorpicker:Set(ColorpickerConfig.Default)

				if ColorpickerConfig.Flag then OrionLib.Flags[ColorpickerConfig.Flag]=Colorpicker end
				return Colorpicker
			end

			function ElementFunction:AddSection(SectionConfig)
				SectionConfig.Name=SectionConfig.Name or "Section"

				local SectionFrame=SetChildren(SetProps(MakeElement("TFrame"),{Size=UDim2.new(1,0,0,20),Parent=Container}),{
					AddThemeObject(SetProps(MakeElement("Label",SectionConfig.Name,14),{Size=UDim2.new(1,-10,0,16),Position=UDim2.new(0,0,0,2),Font=Enum.Font.GothamSemibold}),"TextDark"),
					SetChildren(SetProps(MakeElement("TFrame"),{AnchorPoint=Vector2.new(0,0),Size=UDim2.new(1,0,1,-20),Position=UDim2.new(0,0,0,20),Name="Holder"}),{MakeElement("List",0,4)})
				})

				AddConnection(SectionFrame.Holder.UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"),function()
					SectionFrame.Size=UDim2.new(1,0,0,SectionFrame.Holder.UIListLayout.AbsoluteContentSize.Y+24)
					SectionFrame.Holder.Size=UDim2.new(1,0,0,SectionFrame.Holder.UIListLayout.AbsoluteContentSize.Y)
				end)

				local SectionFunction={}
				for i,v in next,GetElements(SectionFrame.Holder) do SectionFunction[i]=v end
				return SectionFunction
			end

			return ElementFunction
		end

		local ElementFunction={}
		for i,v in next,GetElements(Container) do ElementFunction[i]=v end

		if TabConfig.PremiumOnly then
			for i,v in next,ElementFunction do ElementFunction[i]=function() end end
			Container:FindFirstChild("UIListLayout"):Destroy()
			Container:FindFirstChild("UIPadding"):Destroy()
			SetChildren(SetProps(MakeElement("TFrame"),{Size=UDim2.new(1,0,1,0),Parent=Container}),{
				AddThemeObject(SetProps(MakeElement("Image","rbxassetid://3610239960"),{Size=UDim2.new(0,18,0,18),Position=UDim2.new(0,15,0,15),ImageTransparency=0.4}),"Text"),
				AddThemeObject(SetProps(MakeElement("Label","Unauthorised Access",14),{Size=UDim2.new(1,-38,0,14),Position=UDim2.new(0,38,0,18),TextTransparency=0.4}),"Text"),
				AddThemeObject(SetProps(MakeElement("Image","rbxassetid://4483345875"),{Size=UDim2.new(0,56,0,56),Position=UDim2.new(0,84,0,90)}),"Text"),
				AddThemeObject(SetProps(MakeElement("Label","Premium Features",14),{Size=UDim2.new(1,-150,0,14),Position=UDim2.new(0,150,0,92),Font=Enum.Font.GothamBold}),"Text"),
				AddThemeObject(SetProps(MakeElement("Label","This part of the script is locked to Sirius Premium users. Purchase Premium in the Discord server (discord.gg/sirius)",12),{Size=UDim2.new(1,-200,0,14),Position=UDim2.new(0,150,0,118),TextWrapped=true,TextTransparency=0.4}),"Text")
			})
		end
		return ElementFunction
	end

	OrionLib:MakeNotification({Name="UI Library Upgrade",Content="New UI Library Available at sirius.menu/discord and sirius.menu/rayfield",Time=5})
	return TabFunction
end

function OrionLib:Destroy() Orion:Destroy() end

return OrionLib