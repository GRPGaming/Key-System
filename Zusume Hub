					SetProps(MakeElement("Button"),{Size=UDim2.new(1,0,1,0),Name="BindBtn"})
				}),"Second")

				local function UpdateKeybind(Key)
					local Text=Key and tostring(Key):gsub("Enum.KeyCode.","") or "..."
					KeybindFrame.Value.Text=Text
					Keybind.Value=Key
					KeybindConfig.Callback(Key,KeybindConfig.Hold)
				end

				function Keybind:Set(Key)
					UpdateKeybind(Key)
				end

				AddConnection(KeybindFrame.BindBtn.MouseButton1Click,function()
					KeybindFrame.Value.Text="..."
					Keybind.Binding=true
				end)

				AddConnection(UserInputService.InputBegan,function(Input)
					if Keybind.Binding then
						if Input.UserInputType==Enum.UserInputType.Keyboard then
							UpdateKeybind(Input.KeyCode)
							Keybind.Binding=false
							SaveCfg(game.GameId)
						end
					elseif Keybind.Value and Input.KeyCode==Keybind.Value then
						if KeybindConfig.Hold then
							KeybindConfig.Callback(Keybind.Value,true)
						else
							KeybindConfig.Callback(Keybind.Value,false)
						end
					end
				end)

				AddConnection(UserInputService.InputEnded,function(Input)
					if KeybindConfig.Hold and Keybind.Value and Input.KeyCode==Keybind.Value then
						KeybindConfig.Callback(Keybind.Value,false)
					end
				end)

				if KeybindConfig.Flag then OrionLib.Flags[KeybindConfig.Flag]=Keybind end
				return Keybind
			end

