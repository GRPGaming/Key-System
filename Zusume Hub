function OrionLib:ResetAll()
	for flagName,flagObject in pairs(self.Flags) do
		if flagObject.Type=="Toggle" then flagObject:Set(false)
		elseif flagObject.Type=="Slider" then flagObject:Set(flagObject.Default or flagObject.Min)
		elseif flagObject.Type=="Dropdown" then flagObject:Set(flagObject.Default or "...")
		elseif flagObject.Type=="Colorpicker" then flagObject:Set(flagObject.Default or Color3.new(1,1,1))
		elseif flagObject.Type=="Keybind" then flagObject:Set(flagObject.Default or nil)
		elseif flagObject.Type=="Textbox" then flagObject:Set(flagObject.Default or "") end
	end
end

