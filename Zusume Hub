			function ElementFunction:AddSlider(SliderConfig)
				SliderConfig=SliderConfig or {}
				SliderConfig.Name=SliderConfig.Name or "Slider"
				SliderConfig.Min=SliderConfig.Min or 0
				SliderConfig.Max=SliderConfig.Max or 100
				SliderConfig.Increment=SliderConfig.Increment or 1
				SliderConfig.Default=SliderConfig.Default or 50
				SliderConfig.Callback=SliderConfig.Callback or function() end
				SliderConfig.Flag=SliderConfig.Flag or nil
				SliderConfig.Save=SliderConfig.Save or false

				local Slider={Value=SliderConfig.Default,Default=SliderConfig.Default,Min=SliderConfig.Min,Max=SliderConfig.Max,Type="Slider",Save=SliderConfig.Save}
				local Dragging=false

				local SliderFrame=AddThemeObject(SetChildren(SetProps(MakeElement("RoundFrame",Color3.fromRGB(255,255,255),0,5),{Size=UDim2.new(1,0,0,40),Parent=ItemParent}),{
					AddThemeObject(SetProps(MakeElement("Label",SliderConfig.Name,14),{Size=UDim2.new(1,-10,0,16),Position=UDim2.new(0,10,0,2),Font=Enum.Font.GothamBold,Name="Content"}),"Text"),
					AddThemeObject(SetProps(MakeElement("Label","0",14),{Size=UDim2.new(0,30,0,16),Position=UDim2.new(1,-40,0,2),Font=Enum.Font.GothamSemibold,Name="Value"}),"Text"),
					AddThemeObject(MakeElement("Stroke"),"Stroke"),
					SetProps(MakeElement("Frame"),{Size=UDim2.new(1,-20,0,8),Position=UDim2.new(0,10,1,-12),Name="SliderBar",BackgroundTransparency=1}),
				}),"Second")

				local SliderBar=SliderFrame.SliderBar
				local SliderInner=AddThemeObject(SetProps(MakeElement("Frame"),{Size=UDim2.new(0,0,1,0),BackgroundColor3=SliderConfig.Color or Color3.fromRGB(9,99,195),Name="Inner"}),"Divider")
				SliderInner.Parent=SliderBar
				local SliderGrab=AddThemeObject(SetProps(MakeElement("Frame"),{Size=UDim2.new(0,10,0,14),Position=UDim2.new(0,0,0,-3),AnchorPoint=Vector2.new(0.5,0),BackgroundColor3=SliderConfig.Color or Color3.fromRGB(9,99,195),Name="Grab"}),"Divider")
				SliderGrab.Parent=SliderInner
				MakeElement("Corner",0,2).Parent=SliderInner
				MakeElement("Corner",0,2).Parent=SliderGrab

				local Click=SetProps(MakeElement("Button"),{Size=UDim2.new(1,0,1,0),Parent=SliderBar})

				local function UpdateSlider()
					local Percentage=(Slider.Value-SliderConfig.Min)/(SliderConfig.Max-SliderConfig.Min)
					SliderInner.Size=UDim2.new(Percentage,0,1,0)
					SliderFrame.Value.Text=tostring(Slider.Value)
					SliderConfig.Callback(Slider.Value)
				end

				function Slider:Set(Value)
					Value=math.clamp(Round(Value,SliderConfig.Increment),SliderConfig.Min,SliderConfig.Max)
					Slider.Value=Value
					UpdateSlider()
				end

				Slider:Set(Slider.Value)

				AddConnection(Click.InputBegan,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseButton1 then
						Dragging=true
					end
				end)

				AddConnection(Click.InputEnded,function(Input)
					if Input.UserInputType==Enum.UserInputType.MouseButton1 then
						Dragging=false
					end
				end)

				AddConnection(UserInputService.InputChanged,function(Input)
					if Dragging and Input.UserInputType==Enum.UserInputType.MouseMovement then
						local MousePos=UserInputService:GetMouseLocation()
						local RelativePos=MousePos-SliderBar.AbsolutePosition
						local Percentage=math.clamp(RelativePos.X/SliderBar.AbsoluteSize.X,0,1)
						Slider:Set(SliderConfig.Min+(SliderConfig.Max-SliderConfig.Min)*Percentage)
						SaveCfg(game.GameId)
					end
				end)

				if SliderConfig.Flag then OrionLib.Flags[SliderConfig.Flag]=Slider end
				return Slider
			end

